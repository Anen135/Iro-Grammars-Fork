{
  "name": "mindcode",
  "displayName": "Mindcode",
  "description": "Mindcode language support for the Mindustry game — syntax highlighting, themes, and language configuration.",
  "version": "0.1.0",
  "publisher": "jig-opensource",
  "author": {
    "name": "JIG Open Source",
    "url": "https://gitlab.com/jig-opensource"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/jig-opensource/source-code/Iro-Grammars.git"
  },
  "homepage": "https://gitlab.com/jig-opensource/source-code/Iro-Grammars",
  "bugs": {
    "url": "https://gitlab.com/jig-opensource/source-code/Iro-Grammars/-/issues"
  },
  "keywords": [
    "mindcode",
    "mindustry",
    "mlog",
    "language",
    "syntax",
    "highlighting",
    "theme"
  ],
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mindcode",
        "aliases": [
          "Mindcode",
          "mindcode"
        ],
        "extensions": [
          ".mnd",
          ".mindcode"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mindcode",
        "scopeName": "source.mindcode",
        "path": "./syntaxes/mindcode.plist"
      }
    ],
    "themes": [
      {
        "id": "Default Dark+ Mindcode",
        "label": "%darkPlusMindcodeColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_plus_mindcode.json"
      }
    ]
  }
}